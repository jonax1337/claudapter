{
  "name": "claudapter",
  "version": "0.2.0-rc.2",
  "description": "Your Claude Code. Your choice of models.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "claudapter": "dist/cli.js"
  },
  "exports": "./dist/gateway.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.opencode.json && bun scripts/build-tui.mjs",
    "tui:preview": "npm run build && bun --preload @opentui/solid/preload src/tui/opencode/main.tsx",
    "test:tui": "bun test --preload @opentui/solid/preload ./test/opencode-home.test.tsx",
    "test": "npm run build && node --import ./test/isolate.mjs --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.opencode.json",
    "prepack": "npm run build"
  },
  "overrides": {
    "seroval": "1.6.9"
  },
  "devDependencies": {
    "@opentui/solid": "0.6.6",
    "solid-js": "1.9.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@inkjs/ui": "2.0.0",
    "@opentui/core": "0.6.6",
    "ink": "8.0.0",
    "marked": "18.1.1",
    "react": "19.3.0",
    "string-width": "8.3.0"
  }
}
